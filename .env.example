# Copy to Vercel → Settings → Environment Variables (Production + Preview as needed)

# Required to dispatch GitHub Actions from /api/trigger-refresh
# Fine-grained PAT: repository access to marketUSDA, Permissions → Actions: Read and write
# Or classic PAT: scope `workflow`
GITHUB_TOKEN=

# Optional: if set, POST body must include { "secret": "<same value>" }
TRIGGER_SECRET=

# Optional (defaults: tridinhbui / marketUSDA)
# GITHUB_OWNER=
# GITHUB_REPO=
